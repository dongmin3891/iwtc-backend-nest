NODE_ENV=development
PORT=3001
POSTGRES_DB=iwtc
POSTGRES_USER=iwtc
POSTGRES_PASSWORD=local-iwtc-password-change-me
DATABASE_URL=postgresql://iwtc:local-iwtc-password-change-me@localhost:5432/iwtc
CORS_ORIGINS=http://localhost:3000
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/iwtc
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=iwtc
S3_ACCESS_KEY_ID=local-minio-access-key
S3_SECRET_ACCESS_KEY=local-minio-secret-key
S3_FORCE_PATH_STYLE=true
JWT_ACCESS_SECRET=local-access-secret-change-me-at-least-32-characters
JWT_REFRESH_SECRET=local-refresh-secret-change-me-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
